# Connection String for .NET Application
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=conexao_solidaria;Username=conexaosolidaria;Password=sua_senha_aqui

# JWT Configuration
JwtSettings__Secret=XXX
JwtSettings__Issuer=ConexaoSolidaria.API
JwtSettings__Audience=ConexaoSolidaria.Client
JwtSettings__ExpiracaoAccessTokenMinutos=30
JwtSettings__ExpiracaoRefreshTokenDias=7
JwtSettings__HabilitarSegurancaDeReusoRefreshToken=false

# RabbitMQ Configuration
RabbitMqSettings__Host=localhost
RabbitMqSettings__VirtualHost=/
RabbitMqSettings__Username=guest
RabbitMqSettings__Password=guest

# Observabilidade (OpenTelemetry) — /metrics e /health funcionam sem nada disso;
# o endpoint OTLP só liga o envio de traces/métricas/logs para um coletor
# OTEL_SERVICE_NAME=conexao-solidaria-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317